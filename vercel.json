{
  "version": 2,
  "buildCommand": "cd breadcrumb && npm run build",
  "installCommand": "cd breadcrumb && npm install",
  "outputDirectory": "breadcrumb/build",
  "functions": {
    "breadcrumb/server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.myshopify.com https://admin.shopify.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        }
      ]
    }
  ]
}
